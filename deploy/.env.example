# traceback-coach deploy secrets — COPY to deploy/.env and fill in.
# deploy/.env is gitignored; NEVER commit real values.
#
#   cp deploy/.env.example deploy/.env
#   chmod 600 deploy/.env
#
# Every value below is a PLACEHOLDER, not a working secret. Replace all of them.
#
# Note on the '$' characters below: docker compose / dotenv treats them as
# LITERAL inside .env (no shell expansion of the argon2 hash). Paste the hash
# exactly as printed. If you ever export these in a real shell instead, quote them.
#
# ---------------------------------------------------------------------------
# 1) Cloudflare named-tunnel token.
#    Cloudflare Zero Trust dashboard -> Networks -> Tunnels -> create a tunnel
#    (or open an existing one) -> "Install and run a connector" -> copy the
#    token (the long string after `--token` in the docker command).
#    Then add a Public Hostname:  lab.<your-domain>  ->  Service: HTTP://lab:8888
TUNNEL_TOKEN=REPLACE_WITH_YOUR_CLOUDFLARE_NAMED_TUNNEL_TOKEN

# ---------------------------------------------------------------------------
# 2) Public hostname the tunnel serves (a.k.a. LAB_DOMAIN). Must match the
#    Cloudflare Access application AND the tunnel Public Hostname route above.
#    No scheme, just the host. REQUIRED (the lab fails closed without it).
PUBLIC_HOSTNAME=lab.example.com

# Alias kept for documentation parity; PUBLIC_HOSTNAME is the one the stack reads.
LAB_DOMAIN=lab.example.com

# ---------------------------------------------------------------------------
# 3) Hashed JupyterLab password (argon2id). Generate with:
#
#       python -c "from jupyter_server.auth import passwd; print(passwd())"
#
#    Paste the FULL string below (it MUST start with argon2:$argon2id$...).
#    The placeholder below is NOT valid — the lab refuses to start until you
#    replace it with a real argon2id hash.
JUPYTER_PASSWORD_HASH=argon2:REPLACE_ME_WITH_OUTPUT_OF_passwd__DO_NOT_COMMIT_REAL_HASH
